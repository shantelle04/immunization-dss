# Copy to .env and replace every value. Placeholders are rejected at startup.
# Generate a value: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Django
DJANGO_SECRET_KEY=changeme-generate-a-real-one
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Initial administrator password (minimum 12 characters)
DJANGO_INITIAL_ADMIN_PASSWORD=changeme-generate-a-real-one

# PostgreSQL in Docker (docker-compose.yml). Port 5433 on the host avoids a local server on 5432.
POSTGRES_SUPERUSER_PASSWORD=changeme-generate-a-real-one
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=immdss
# Application role
DB_USER=immdss_app
DB_PASSWORD=changeme-generate-a-real-one
# Test role (separate credential; creates and drops the test database)
DB_TEST_USER=immdss_test
DB_TEST_PASSWORD=changeme-generate-a-real-one

# Clinical 'today' for the synthetic demo: the dataset's as-of date. Leave empty to use the real date.
IMMDSS_TODAY=2025-12-29
