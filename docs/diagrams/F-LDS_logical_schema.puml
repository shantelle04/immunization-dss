  }
}
package "passport" {
  entity "passport_antigen" as antigen {
    * id : bigint <<PK>>
    --
    * code : varchar(8) <<UK>>
    * name : varchar(80)
    * doses_per_vial : smallint
    * open_vial_policy : boolean
  }
  entity "passport_scheduledose" as scheduledose {
    * id : bigint <<PK>>
    --
    * dose_code : varchar(12) <<UK>>
    * antigen_id : bigint <<FK>>
    * dose_number : smallint
    * contact : varchar(8)
    * recommended_age_days : integer
    * min_age_days : integer
    * max_age_days : integer
    * min_interval_days : integer
  }
  entity "passport_child" as child {
    * id : uuid <<PK>>
    --
    * system_id : varchar(32) <<UK>>
    source_ref : varchar(16) <<UK>>
    * given_name : varchar(80)
    * family_name : varchar(80)
    * sex : char(1)
    * date_of_birth : date
    * caregiver_name : varchar(120)
    * registration_facility_id : bigint <<FK>>
    * registered_on : date
    * is_synthetic : boolean
  }
  entity "passport_immunizationevent" as immunizationevent {
    * id : bigint <<PK>>
    --
    source_ref : varchar(16) <<UK>>
    * child_id : uuid <<FK>>
    * schedule_dose_id : bigint <<FK>>
    * given_on : date
    * facility_id : bigint <<FK>>
    session_id : bigint <<FK>>
    lot_id : bigint <<FK>>
    recorded_by_id : bigint <<FK>>
    * is_synthetic : boolean
    UK (child_id, schedule_dose_id)
  }
}
package "inventory" {
  entity "inventory_vaccinelot" as vaccinelot {
    * id : bigint <<PK>>
    --
    * lot_number : varchar(32) <<UK>>
    * antigen_id : bigint <<FK>>
