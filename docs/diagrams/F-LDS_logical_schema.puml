    facility_id : bigint <<FK>>
    * is_active : boolean
    * failed_logins : smallint
    * locked_until : timestamptz
    * last_login : timestamptz
  }
  entity "accounts_auditlog" as auditlog {
    * id : bigint <<PK>>
    --
    * at : timestamptz
    * user_id : bigint <<FK>>
    facility_id : bigint <<FK>>
    * action : varchar(32)
