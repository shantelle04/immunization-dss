    UK (run_id, facility_id, antigen_id, week_start)
  }
  entity "inventory_stockalert" as stockalert {
    * id : bigint <<PK>>
    --
    * run_id : bigint <<FK>>
    * facility_id : bigint <<FK>>
    * antigen_id : bigint <<FK>>
    * raised_on : date
    * projected_breach_week : date
    * projected_doses : numeric(10,2)
    * safety_minimum : numeric(10,2)
    * status : varchar(16)
    acknowledged_by_id : bigint <<FK>>
    * acknowledged_at : timestamptz
  }
}
package "scheduling" {
  entity "scheduling_outreachsession" as outreachsession {
    * id : bigint <<PK>>
