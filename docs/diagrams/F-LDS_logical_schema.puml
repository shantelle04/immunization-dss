    expiry : date
  }
  entity "inventory_stocktransaction" as stocktransaction {
    * id : bigint <<PK>>
    --
    source_ref : varchar(16) <<UK>>
    * facility_id : bigint <<FK>>
    * antigen_id : bigint <<FK>>
    lot_id : bigint <<FK>>
    * kind : varchar(16)
    * quantity_doses : integer
    * occurred_on : date
    session_id : bigint <<FK>>
    recorded_by_id : bigint <<FK>>
    * is_synthetic : boolean
  }
  entity "inventory_stockpolicy" as stockpolicy {
    * id : bigint <<PK>>
    --
    * facility_id : bigint <<FK>>
    * antigen_id : bigint <<FK>>
    * cycle_weeks : smallint
    * safety_buffer : numeric(4,2)
    UK (facility_id, antigen_id)
  }
  entity "inventory_forecastrun" as forecastrun {
    * id : bigint <<PK>>
    --
    * run_at : timestamptz
    * git_sha : varchar(40)
