@startuml F-UC_use_case
' F-UC Use case diagram. Requirements: docs/02 (FR IDs in brackets). Traceability: traceability.md
!include style.iuml
left to right direction
skinparam nodesep 12
skinparam ranksep 60

actor "Healthcare worker" as HCW
actor "Facility manager" as FM
actor "System administrator" as SA
actor "Scheduler\n<<system>>" as CRON
FM -|> HCW : is a

rectangle "Immunization Decision Support System" {
  usecase "UC-01 Log in / log out\n[FR-01]" as UC01

  package "M3 Health passport" {
    usecase "UC-12 Register child\n[FR-30]" as UC12
    usecase "UC-13 Search child record\n[FR-32]" as UC13
    usecase "UC-15 View immunization history\n[FR-33]" as UC15
    usecase "UC-16 Export FHIR record\n[FR-34]" as UC16
    usecase "UC-14 Record immunization\n[FR-31]" as UC14
  }

  package "M2 Scheduling and defaulters" {
    usecase "UC-09 View defaulter list\n[FR-20, FR-21, FR-22]" as UC09
    usecase "UC-11 Record session attendance\n[FR-24]" as UC11
    usecase "UC-10 Plan outreach session\n[FR-23]" as UC10
  }

  package "M1 Predictive inventory" {
    usecase "UC-04 Record stock transaction\n[FR-10]" as UC04
    usecase "UC-05 View inventory dashboard\n[FR-11, FR-12, FR-15]" as UC05
    usecase "UC-06 Acknowledge stock-out alert\n[FR-13]" as UC06
    usecase "UC-07 Configure stock policy\n[FR-14]" as UC07
    usecase "UC-08 Generate forecasts and alerts\n[FR-12, FR-13, FR-16]" as UC08
  }

  package "Administration" {
    usecase "UC-17 Import CSV with dry run\n[FR-40]" as UC17
    usecase "UC-18 View audit log\n[FR-41]" as UC18
    usecase "UC-02 Manage users\n[FR-03]" as UC02
    usecase "UC-03 Manage facilities and schedule\n[FR-03]" as UC03
  }
}

HCW --> UC01
HCW --> UC12
HCW --> UC13
HCW --> UC15
HCW --> UC14
HCW --> UC09
HCW --> UC11
HCW --> UC04
HCW --> UC05

FM --> UC10
FM --> UC06
FM --> UC07
FM --> UC17
FM --> UC18

UC01 <-- SA
UC02 <-- SA
UC03 <-- SA
UC08 <-- CRON

UC15 ..> UC13 : <<include>>
UC16 .> UC15 : <<extend>>
UC11 ..> UC14 : <<include>>
UC14 ..> UC04 : <<include>>\nautomatic issue
UC10 ..> UC09 : <<include>>
UC10 ..> UC05 : <<include>>\nstock and forecast
UC06 .> UC05 : <<extend>>

note bottom of HCW
  A facility manager can do everything a
  healthcare worker can (generalisation).
  All clinical use cases are limited to the
  user's own facility, except UC-13 (BR-08).
end note
@enduml
